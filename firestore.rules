rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Seuls les deux comptes Google ci-dessous peuvent lire et écrire.
    // Remplacez les adresses (en minuscules), puis publiez dans
    // Firebase > Firestore Database > Règles.
    function autorise() {
      return request.auth != null
        && request.auth.token.email in ['ADRESSE1@gmail.com', 'ADRESSE2@gmail.com'];
    }
    match /entrees/{jour} {
      // Lecture : l'application lit la liste complète des jours
      allow read: if autorise();
      // Écriture : un document par jour, identifiant AAAA-MM-JJ
      allow write: if autorise() && jour.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }
    match /parametres/{doc} {
      allow read, write: if autorise();
    }
  }
}
